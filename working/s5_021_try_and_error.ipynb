    "\n",
    "class EdgeCheckSummaryDict(TypedDict):\n",
    "    dataset         : str\n",
    "    total_gt_edges  : int\n",
    "    total_pred_edges: int\n",
    "    tp              : int\n",
    "    fp              : int\n",
    "    fn              : int\n",
    "    precision       : float\n",
    "    recall          : float\n",
    "    f1_score        : float\n",
    "    official_edge_tp: Optional[int]\n",
    "    official_edge_fp: Optional[int]\n",
    "    official_edge_fn: Optional[int]\n",
    "\n",
    "class EdgeItemDict(TypedDict):\n",
    "    source_id: int\n",
    "    target_id: int\n",
    "\n",
    "class NodeItemDict(TypedDict):\n",
    "    node_id: int\n",
    "    t      : int\n",
    "    z      : float\n",
    "    y      : float\n",
    "    x      : float\n",
    "\n"
